# Option A: single connection via environment variables (implicit profile name: env)
ODOO_URL=https://your-odoo-instance.com
ODOO_DB=your_database_name
ODOO_USER=your_username
ODOO_API_KEY=your_api_key_or_password

# Option B: named profiles in ~/.config/odoo-mcp-server/connections.json
# Run: odoo-mcp-server configure
# ODOO_CONNECTION=production

# Optional
# ODOO_MCP_CONFIG=/path/to/connections.json
# ODOO_READONLY=true
